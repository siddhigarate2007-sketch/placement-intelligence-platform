{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start Backend (FastAPI - Port 8000)",
      "type": "shell",
      "command": "& \"$env:LOCALAPPDATA\\Python\\pythoncore-3.15-64\\python.exe\" -m uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      }
    },
    {
      "label": "2. Start Frontend (Next.js - Port 3000)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      }
    },
    {
      "label": "Start Full Platform (Backend + Frontend)",
      "dependsOn": [
        "1. Start Backend (FastAPI - Port 8000)",
        "2. Start Frontend (Next.js - Port 3000)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
